<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body class="app-body">
  <div class="app-shell">
    <% include('partials/sidebar', { active: 'dashboard' }); %>

    <div class="app-main">
      <% include('partials/topbar', { userName: 'Irfan Ahmad' }); %>

      <div class="app-content">
        <!-- Hero banner -->
        <section class="hero-card">
          <div class="hero-text">
            <h2>Welcome back, Irfan Ahmad! 👋</h2>
            <p>
              You have <strong><%= stats.projects %></strong> active projects and
              <strong><%= stats.tasks %></strong> tasks pending. Let’s make today productive!
            </p>
            <button class="hero-btn">➕ New Project</button>
          </div>
        </section>

        <div class="app-grid">
          <div class="app-grid-main">
            <!-- KPI cards -->
            <section class="kpi-row">
              <div class="kpi-card">
                <div class="kpi-icon kpi-icon-blue">📁</div>
                <div class="kpi-label">Active Projects</div>
                <div class="kpi-value"><%= stats.projects %></div>
                <div class="kpi-sub">Total projects</div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon kpi-icon-green">✅</div>
                <div class="kpi-label">Task Completion</div>
                <div class="kpi-value">0%</div>
                <div class="kpi-sub">0 / <%= stats.tasks %> tasks</div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon kpi-icon-purple">⏱</div>
                <div class="kpi-label">On-Time Delivery</div>
                <div class="kpi-value">0%</div>
                <div class="kpi-sub">Tasks on schedule</div>
              </div>

              <div class="kpi-card">
                <div class="kpi-icon kpi-icon-orange">⚠</div>
                <div class="kpi-label">Task Backlog</div>
                <div class="kpi-value">0</div>
                <div class="kpi-sub">Overdue / pending</div>
              </div>
            </section>

            <!-- Your tasks -->
            <section class="panel-card">
              <div class="panel-header">
                <h3>Your Tasks</h3>
                <span class="panel-meta">0 total • 0 completed</span>
              </div>
              <div class="panel-body panel-empty">
                No tasks assigned to you yet.
              </div>
            </section>

            <!-- My projects -->
            <section class="panel-card">
              <div class="panel-header">
                <h3>My Projects</h3>
                <a href="/projects" class="panel-link">See more</a>
              </div>
              <div class="panel-body">
                <% if (stats.projects === 0) { %>
                  <div class="panel-empty">
                    You don’t have any projects yet. Create your first one to get started.
                  </div>
                <% } else { %>
                  <!-- later you can loop projects here -->
                  <div class="project-row">
                    <div class="project-main">
                      <div class="project-name">Sample Project</div>
                      <div class="project-sub">Service • 0% progress</div>
                    </div>
                    <a href="/projects" class="project-link">View Project →</a>
                  </div>
                <% } %>
              </div>
            </section>
          </div>

          <!-- Right column: team activity -->
          <aside class="side-panel">
            <section class="panel-card">
              <div class="panel-header">
                <h3>Team Activity</h3>
              </div>
              <div class="team-status-row">
                <button class="team-status-pill is-on">0 IN</button>
                <button class="team-status-pill">0 BREAK</button>
                <button class="team-status-pill">0 OUT</button>
              </div>
              <div class="team-search">
                <input type="text" placeholder="Search members..." />
              </div>
              <div class="panel-body panel-empty">
                No one clocked in.
              </div>
            </section>
          </aside>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
