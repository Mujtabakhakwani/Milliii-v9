<% layout('layout') -%>

<h2>Send Password Reset Email</h2>

<form method="POST" action="/email/send-password-reset">
  <label>Recipient Email</label>
  <input type="email" name="recipient" required>

  <label>Reset Link</label>
  <input type="text" name="reset_link" required>

  <label>Expiration (hours)</label>
  <input type="number" name="expiration_hours" value="1" min="1">

  <button type="submit">Send</button>
</form>
